APP_NAME="MFM Youth Church CRM"
APP_ENV=production
APP_KEY=base64:GENERATE_A_STABLE_KEY
APP_DEBUG=false
APP_URL=https://your-project.vercel.app
APP_TIMEZONE=Africa/Lagos
LOG_CHANNEL=stderr
LOG_LEVEL=warning
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DB_CONNECTION=pgsql
DB_SSLMODE=require
SESSION_DRIVER=database
SESSION_ENCRYPT=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
DEMO_SEED=false
DEMO_SEED_EMAIL=admin@example.org
DEMO_SEED_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
DEMO_SEED_NAME="Church Administrator"
